+#ifndef __RECOMP_CONFIG_HPP__
+#define __RECOMP_CONFIG_HPP__
+
+#include <filesystem>
+#include <string>
+#include <vector>
+#include <unordered_set>
+#include <unordered_map>
+#include <variant>
+#include <functional>
+
