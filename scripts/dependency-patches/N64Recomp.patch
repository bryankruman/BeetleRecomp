+        };
+        for (const auto& name : config.stubbed_funcs)
+            if (targets_original(name)) return reject(binding.name, "later stub policy");
+        for (const auto& name : config.ignored_funcs)
+            if (targets_original(name)) return reject(binding.name, "later ignore policy");
+        for (const auto& name : config.renamed_funcs)
