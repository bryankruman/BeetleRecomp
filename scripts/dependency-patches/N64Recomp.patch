+std::vector<N64Recomp::OriginalFunctionBinding> get_original_bindings(const toml::table* patches) {
+    std::vector<N64Recomp::OriginalFunctionBinding> result;
+    const auto node = (*patches)["original_bindings"];
+    if (!node) return result;
+    if (!node.is_array() || node.as_array()->size() != 29) {
+        throw toml::parse_error("original_bindings must contain exactly 29 entries", patches->source());
+    }
+    auto nibble = [](char ch) -> int {
+        if (ch >= '0' && ch <= '9') return ch - '0';
+        if (ch >= 'a' && ch <= 'f') return ch - 'a' + 10;
+        if (ch >= 'A' && ch <= 'F') return ch - 'A' + 10;
+        return -1;
+    };
+    for (const auto& entry : *node.as_array()) {
+        const auto* row = entry.as_table();
+        if (!row || row->size() != 6) {
+            throw toml::parse_error("Invalid original binding schema", entry.source());
+        }
+        auto name = (*row)["name"].value<std::string>();
+        auto elf_name = (*row)["elf_name"].value<std::string>();
+        auto section = (*row)["section"].value<std::string>();
+        auto vram = (*row)["vram"].value<uint32_t>();
+        auto size = (*row)["size"].value<uint32_t>();
+        auto encoded = (*row)["instruction_bytes"].value<std::string>();
+        if (!name || !elf_name || !section || !vram || !size || !encoded ||
+            *size == 0 || *size > 65536 || (*size & 3) || (*vram & 3) ||
+            encoded->size() != size_t(*size) * 2) {
+            throw toml::parse_error("Invalid original binding fields", entry.source());
+        }
+        std::vector<uint8_t> bytes;
+        bytes.reserve(*size);
+        for (size_t offset = 0; offset < encoded->size(); offset += 2) {
+            int high = nibble((*encoded)[offset]);
+            int low = nibble((*encoded)[offset + 1]);
+            if (high < 0 || low < 0) {
+                throw toml::parse_error("Invalid private instruction encoding", entry.source());
+            }
+            bytes.push_back(uint8_t((high << 4) | low));
+        }
+        result.push_back({*name, *elf_name, *section, *vram, *size, std::move(bytes)});
+    }
+    return result;
 }
 
