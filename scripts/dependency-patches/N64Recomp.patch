+        if (!std::equal(binding.instruction_bytes.begin(), binding.instruction_bytes.end(), actual)) {
+            return reject(binding.name, "instruction identity");
+        }
+        // Prefer the logical spelling, then its parser suffix, then only the
+        // exact raw positive symbol authenticated by the private generator.
+        const std::vector<std::string> names = {binding.name, binding.name + "_recomp",
