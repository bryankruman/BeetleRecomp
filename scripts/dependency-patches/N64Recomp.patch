+            return reject(binding.name, "missing authenticated spelling or output-name conflict");
+        }
+        plans.push_back(std::move(plan));
+    }
+    if (fulfilled != required || used.size() != required.size()) return reject("policy", "incomplete binding");
+    // Only names and the existing original-policy flags change. All instruction,
+    // section, VMA-index, relocation, and caller-routing data remain untouched.
+    for (const auto& plan : plans) {
+        for (const auto& name : plan.erase) context.functions_by_name.erase(name);
+        auto& function = context.functions[plan.index];
+        function.name = plan.name;
+        function.ignored = false;
+        function.reimplemented = false;
+        context.functions_by_name.emplace(plan.name, plan.index);
+    }
+    fmt::print("Verified {} original function identities\n", plans.size());
+    return true;
+}
 
