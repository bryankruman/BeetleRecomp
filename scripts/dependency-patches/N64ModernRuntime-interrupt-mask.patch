+// There are no interrupts to mask, but the game uses these calls to mark critical sections (for
+// example libultra's audio event queue, which the game thread edits while the audio thread reads it).
+// A port that yields game threads cooperatively must not yield inside one, so track the mask per N64
+// thread (each runs on its own host thread) and expose it through recomp_interrupts_masked().
+static constexpr uint32_t os_im_all = 0x003FFF01;   // OS_IM_ALL
+static thread_local uint32_t thread_int_mask = os_im_all;
+static thread_local bool thread_ints_enabled = true;
+
+extern "C" int recomp_interrupts_masked() {
+    return !thread_ints_enabled || (thread_int_mask & os_im_all) != os_im_all;
+}
