+// A replacement occupies at most 16 bytes. Include the following page if an
+// entry point falls near a boundary; Apple Silicon commonly uses 16 KiB pages.
+std::pair<uintptr_t, size_t> patch_page_range(void* target_func) {
+    const uintptr_t address = reinterpret_cast<uintptr_t>(target_func);
+    const size_t page_size = static_cast<size_t>(getpagesize());
+    const uintptr_t first = address / page_size * page_size;
+    const uintptr_t end = (address + 15) / page_size * page_size + page_size;
+    return {first, static_cast<size_t>(end - first)};
+}
